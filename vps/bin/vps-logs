#!/usr/bin/env bash
# Logs del contenedor activo de un proyecto. Uso: vps-logs <proyecto> [servicio]   (por defecto app)
set -euo pipefail
source /opt/vps/admin/lib/comun.sh
p=${1:-}
nombre_valido "$p"
color=""
[ -f "/srv/apps/$p/estado" ] && source "/srv/apps/$p/estado"
[ -n "$color" ] || falla "$p no tiene ninguna versión activa."
exec docker logs -f --tail 200 "$p-$color-${2:-app}-1"

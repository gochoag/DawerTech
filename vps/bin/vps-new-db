#!/usr/bin/env bash
# Crea la base y el usuario de un proyecto en el Postgres compartido, o con --recrear la vacía
# conservando la clave (docs/vps/01-configuracion-vps.md, paso 8).
set -euo pipefail

uso() { echo "Uso: sudo vps-new-db <proyecto> [--recrear]   (proyecto: minúsculas, números y _)" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || { echo "Ejecuta con sudo." >&2; exit 1; }
p=${1:-}
modo=${2:-}
[[ "$p" =~ ^[a-z][a-z0-9_]{1,30}$ ]] || uso
case "$p" in postgres|template0|template1) echo "Nombre reservado: $p" >&2; exit 1 ;; esac
[ -z "$modo" ] || [ "$modo" = "--recrear" ] || uso

sql() { docker exec -i postgres psql -U postgres -v ON_ERROR_STOP=1 -qtA "$@"; }
existe=$(sql -c "SELECT 1 FROM pg_roles WHERE rolname = '$p'")

if [ "$modo" = "--recrear" ]; then
  [ -n "$existe" ] || { echo "No existe el usuario $p: créalo sin --recrear." >&2; exit 1; }
  read -rp "Esto BORRA todos los datos de la base $p. Escribe el nombre del proyecto para confirmar: " r
  [ "$r" = "$p" ] || { echo "Cancelado: no se borró nada."; exit 1; }
  sql -c "DROP DATABASE IF EXISTS $p WITH (FORCE)"
  sql -c "CREATE DATABASE $p OWNER $p"
  sql -c "REVOKE CONNECT ON DATABASE $p FROM PUBLIC"
  echo "Base $p vacía y recreada. La clave y la URL no cambian."
  exit 0
fi

[ -z "$existe" ] || { echo "El usuario $p ya existe. Para vaciar su base: sudo vps-new-db $p --recrear" >&2; exit 1; }
clave=$(openssl rand -hex 24)
# La clave va por la entrada estándar, no en la línea de comandos (no aparece en ps).
sql <<SQL
CREATE ROLE $p LOGIN PASSWORD '$clave' CONNECTION LIMIT 20;
CREATE DATABASE $p OWNER $p;
REVOKE CONNECT ON DATABASE $p FROM PUBLIC;
REVOKE CONNECT ON DATABASE postgres FROM PUBLIC;
REVOKE CONNECT ON DATABASE template1 FROM PUBLIC;
ALTER ROLE $p SET statement_timeout = '30s';
ALTER ROLE $p SET idle_in_transaction_session_timeout = '60s';
SQL
echo "Base y usuario $p creados. Guarda esta URL ahora: no se vuelve a mostrar."
echo "postgresql://$p:$clave@postgres:5432/$p"
echo "(SQLAlchemy con psycopg: cambia el inicio por postgresql+psycopg://)"

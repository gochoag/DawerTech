#!/usr/bin/env bash
# Limpieza semanal de imágenes Docker: de cada proyecto conserva las 3 más recientes y las versiones
# activa y anterior (para poder volver atrás); borra además las imágenes sin etiqueta.
set -euo pipefail
source /opt/vps/admin/lib/comun.sh
[ "$(id -u)" -eq 0 ] || falla "Ejecuta con sudo."

for p in $(proyectos); do
  repo=$(campo "$p" repo)
  sha="" anterior=""
  [ -f "/srv/apps/$p/estado" ] && source "/srv/apps/$p/estado"
  # docker image ls lista de la más nueva a la más vieja.
  docker image ls "ghcr.io/${repo,,}" --format '{{.Tag}}' | tail -n +4 | while read -r etiqueta; do
    [ "$etiqueta" = "$sha" ] || [ "$etiqueta" = "$anterior" ] || \
      docker image rm "ghcr.io/${repo,,}:$etiqueta" >/dev/null 2>&1 || true
  done
done
docker image prune -f >/dev/null
docker system df

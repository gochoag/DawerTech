#!/usr/bin/env bash
# Da de alta un proyecto registrado en projects.yml: carpetas, sitios nginx desde las plantillas
# y, si usa el Postgres compartido, su base. Se puede repetir sin romper nada.
# Uso: sudo vps-new-project <proyecto>
set -euo pipefail
source /opt/vps/admin/lib/comun.sh
[ "$(id -u)" -eq 0 ] || falla "Ejecuta con sudo."
p=${1:-}
nombre_valido "$p"

web=$(campo "$p" dominios.web "")
api=$(campo "$p" dominios.api "")
read -r puerto_azul _ <<< "$(campo "$p" puertos "")"
base=$(campo "$p" base ninguna)
[ -n "$web$api" ] || falla "$p no tiene dominios en projects.yml."
[ -z "$api" ] || [ -n "$puerto_azul" ] || falla "$p tiene API pero no puertos en projects.yml."

dir=/srv/apps/$p
install -d -o deploy -g deploy -m 755 "$dir" "$dir/versiones" "$dir/web" "$dir/web/releases"
install -d -o 10001 -g 10001 -m 750 "$dir/data"
install -d -m 755 /srv/backups
install -d -o deploy -g deploy -m 700 "/srv/backups/$p"
[ -f "$dir/.env" ] || install -o deploy -g deploy -m 600 /dev/null "$dir/.env"

# Certificado Origin del dominio o de su dominio padre (*.dominio).
cert() {
  local d=$1
  for c in "$d" "${d#*.}"; do
    if [ -f "/etc/ssl/cloudflare/$c.pem" ] && [ -f "/etc/ssl/cloudflare/$c.key" ]; then
      echo "/etc/ssl/cloudflare/$c"
      return
    fi
  done
  falla "Falta el certificado Origin de $d en /etc/ssl/cloudflare (paso 7)."
}
render() {  # render <plantilla> <dominio>
  local c
  c=$(cert "$2")
  sed -e "s|__PROYECTO__|$p|g" -e "s|__WEB__|$web|g" -e "s|__API__|$api|g" -e "s|__CERT__|$c|g" \
    "$INFRA/templates/$1"
}

install -m 644 "$INFRA/templates/vps-tls.conf" "$INFRA/templates/vps-cabeceras.conf" /etc/nginx/snippets/
install -d -m 755 /etc/nginx/vps-extra
sitio=/etc/nginx/sites-available/$p.conf
{
  if [ -n "$web" ]; then
    render web.conf "$web"
    if [[ "$web" =~ ^[^.]+\.[^.]+$ ]]; then render www.conf "$web"; fi
  fi
  if [ -n "$api" ]; then render api.conf "$api"; fi
} > "$sitio.nuevo"

if [ -n "$api" ] && [ ! -f "/etc/nginx/upstreams/$p.conf" ]; then
  echo "server 127.0.0.1:$puerto_azul;" > "/etc/nginx/upstreams/$p.conf"
  chown deploy:deploy "/etc/nginx/upstreams/$p.conf"
fi
[ -f "$sitio" ] && cp "$sitio" "$sitio.anterior"
mv -f "$sitio.nuevo" "$sitio"
ln -sf "$sitio" "/etc/nginx/sites-enabled/$p.conf"
if ! nginx -t 2>&1 | tail -2; then
  if [ -f "$sitio.anterior" ]; then mv -f "$sitio.anterior" "$sitio"; else rm -f "$sitio" "/etc/nginx/sites-enabled/$p.conf"; fi
  falla "nginx rechazó el sitio de $p: se dejó como estaba."
fi
rm -f "$sitio.anterior"
systemctl reload nginx
echo "Sitio nginx de $p activo: ${web:+https://$web }${api:+https://$api}"

if [ "$base" = postgres ]; then
  bd=$(campo "$p" bd "$p")
  if [ -n "$(docker exec postgres psql -U postgres -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$bd'")" ]; then
    echo "La base $bd ya existe: no se toca."
  else
    /opt/vps/admin/bin/vps-new-db "$bd"
  fi
fi

echo
echo "Falta: rellenar $dir/.env (sudo nano $dir/.env) con los valores del .env.example del proyecto."

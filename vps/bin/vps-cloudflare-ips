#!/usr/bin/env bash
# Abre el 443 solo a los rangos de Cloudflare y genera la configuración real_ip de nginx
# (docs/vps/01-configuracion-vps.md, paso 5). Lo ejecuta un temporizador semanal.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Ejecuta con sudo." >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

for v in 4 6; do
  curl -fsS --max-time 20 "https://www.cloudflare.com/ips-v$v" -o "$tmp/v$v"
done
# Los archivos de Cloudflare pueden no terminar en salto de línea.
rangos=$( { cat "$tmp/v4"; echo; cat "$tmp/v6"; echo; } | grep -E '^[0-9a-fA-F:.]+/[0-9]+$' || true)
total=$(printf '%s\n' "$rangos" | grep -c . || true)
if [ "$total" -lt 10 ]; then
  echo "La lista de Cloudflare llegó vacía o incompleta ($total rangos): no se cambia nada." >&2
  exit 1
fi

# 1) Añadir primero (ufw ignora las reglas que ya existen), así el 443 nunca queda cerrado.
for r in $rangos; do
  ufw allow proto tcp from "$r" to any port 443 comment cloudflare >/dev/null
done

# 2) Borrar las reglas «cloudflare» cuyo rango ya no está en la lista (de mayor a menor número).
ufw status numbered \
  | sed -nE 's/^\[ *([0-9]+)\] +443\/tcp( \(v6\))? +ALLOW IN +([^ ]+) +# cloudflare$/\1 \3/p' \
  | sort -rn \
  | while read -r num origen; do
      if ! printf '%s\n' "$rangos" | grep -qxF "$origen"; then
        ufw --force delete "$num" >/dev/null
        echo "Quitado de ufw: $origen"
      fi
    done

# 3) nginx: ver la IP real del visitante en logs y límites, no la de Cloudflare.
destino=/etc/nginx/conf.d/cloudflare-realip.conf
{
  echo "# Generado por vps-cloudflare-ips; no editar a mano."
  for r in $rangos; do echo "set_real_ip_from $r;"; done
  echo "real_ip_header CF-Connecting-IP;"
} > "$tmp/realip.conf"
[ -f "$destino" ] && cp "$destino" "$tmp/anterior.conf"
install -m 644 "$tmp/realip.conf" "$destino"
if ! nginx -t 2>"$tmp/nginx.err"; then
  if [ -f "$tmp/anterior.conf" ]; then cp "$tmp/anterior.conf" "$destino"; else rm -f "$destino"; fi
  cat "$tmp/nginx.err" >&2
  echo "nginx rechazó la configuración nueva: se dejó la anterior." >&2
  exit 1
fi
systemctl reload nginx
echo "Cloudflare: $total rangos en ufw (443) y en nginx."

#!/usr/bin/env bash
# Estado del VPS y de cada proyecto: versión activa, salud, consumo y disco.
set -euo pipefail
source /opt/vps/admin/lib/comun.sh

printf '%-16s %-7s %-12s %-10s %s\n' PROYECTO COLOR VERSION SALUD DISCO
for p in $(proyectos); do
  color="" sha=""
  [ -f "/srv/apps/$p/estado" ] && source "/srv/apps/$p/estado"
  salud=-
  if [ -n "$color" ]; then
    salud=$(docker inspect -f '{{.State.Health.Status}}' "$p-$color-app-1" 2>/dev/null) || salud=caido
  fi
  disco=$(du -sh "/srv/apps/$p" 2>/dev/null | cut -f1 || echo "-")
  printf '%-16s %-7s %-12s %-10s %s\n' "$p" "${color:--}" "${sha:0:12}" "${salud:--}" "${disco:--}"
done
echo
docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.PIDs}}'
echo
free -h
df -h / | tail -1 | awk '{print "Disco: " $3 " usados de " $2 " (" $5 ")"}'
docker system df

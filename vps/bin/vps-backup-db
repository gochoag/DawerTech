#!/usr/bin/env bash
# Volcado diario de cada base del Postgres compartido en /srv/backups/<proyecto>/ (7 días),
# más los usuarios y permisos en /srv/backups/globales/. Conserva los 5 últimos volcados previos a migraciones.
set -euo pipefail
source /opt/vps/admin/lib/comun.sh
[ "$(id -u)" -eq 0 ] || falla "Ejecuta con sudo."

hoy=$(date -u +%F)
fallos=0
install -d -m 700 /srv/backups/globales
if docker exec postgres pg_dumpall -U postgres --globals-only > "/srv/backups/globales/$hoy.sql.tmp"; then
  mv -f "/srv/backups/globales/$hoy.sql.tmp" "/srv/backups/globales/$hoy.sql"
else
  rm -f "/srv/backups/globales/$hoy.sql.tmp"
  fallos=1
fi
find /srv/backups/globales -name '*.sql' -mtime +7 -delete

for p in $(proyectos); do
  [ "$(campo "$p" base ninguna)" = postgres ] || continue
  bd=$(campo "$p" bd "$p")
  destino=/srv/backups/$p
  install -d -o deploy -g deploy -m 700 "$destino"
  if docker exec postgres pg_dump -U postgres -Fc "$bd" > "$destino/diario-$hoy.dump.tmp"; then
    mv -f "$destino/diario-$hoy.dump.tmp" "$destino/diario-$hoy.dump"
    echo "$p: $(du -h "$destino/diario-$hoy.dump" | cut -f1)"
  else
    rm -f "$destino/diario-$hoy.dump.tmp"
    aviso "ERROR en $(hostname): no se pudo respaldar la base $bd de $p."
    fallos=1
  fi
  find "$destino" -name 'diario-*.dump' -mtime +7 -delete
  ls -1t "$destino"/pre-*.dump 2>/dev/null | tail -n +6 | xargs -r rm -f || true
done
exit "$fallos"

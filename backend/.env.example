# Configuración local para DawerTech API
# Copia este archivo a .env: Copy-Item .env.example .env (o cp .env.example .env)

DAWERTECH_DATABASE_URL=sqlite:///inventory.sqlite3
DAWERTECH_MEDIA_DIR=media
# Cuota para todas las fotos. Cada nueva imagen se optimiza a un maximo de 250 KiB.
DAWERTECH_MEDIA_QUOTA_MB=100
DAWERTECH_SECRET_KEY=cambiar-por-una-clave-secreta-de-al-menos-32-caracteres
DAWERTECH_CORS_ORIGINS=http://localhost:4200,http://localhost:8100,https://localhost

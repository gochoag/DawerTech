{
  "name": "dawertech-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node scripts/write-config.mjs && ng serve --host 0.0.0.0",
    "build": "node scripts/write-config.mjs && ng build",
    "build:android": "node scripts/write-config.mjs --android && ng build && cap sync android",
    "android:generate": "node scripts/android-release.mjs",
    "android:dev": "node scripts/android-dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:session": "node --test tests/*.test.mjs",
    "check:rules": "python ../scripts/check_rules.py"
  },
  "dependencies": {
    "@angular/animations": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@ionic/angular": "9.0.5",
    "ionicons": "^8.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2"
  }
}

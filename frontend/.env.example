# Configuración pública del frontend: nunca incluir contraseñas ni claves.
# Vacío: la web usa el host que sirve la página y el puerto 5000.
DAWERTECH_API_URL=
# Vacío: al compilar Android se detecta la IP física del PC en la red local.
# También puedes fijar la IP del PC (conviene reservarla en DHCP).
DAWERTECH_ANDROID_API_URL=

# Para un despliegue, establece ambas URLs en https://tu-dominio/api/v1.
# Después reinicia pn start o vuelve a generar el APK con pn android:dev.
# Puedes usar otro archivo con DAWERTECH_ENV_FILE=.env.production.

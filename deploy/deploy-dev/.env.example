# Copia a .env en esta carpeta (no se versiona). Misma base que backend/.env: dawer-bd en tu Windows.
DAWERTECH_DATABASE_URL=postgresql+psycopg://postgres:CAMBIAR@localhost:5432/dawer-bd
# La misma de backend/.env: así una sesión iniciada vale en los dos servidores.
DAWERTECH_SECRET_KEY=
DAWERTECH_CORS_ORIGINS=http://localhost:4200,http://localhost:8100,https://localhost
DAWERTECH_MEDIA_DIR=/app/media
DAWERTECH_MEDIA_QUOTA_MB=100

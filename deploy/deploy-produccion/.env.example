# Variables de producción de DawerTech. El .env real solo existe en el VPS: /srv/apps/dawertech/.env (600, dueño deploy).
# La URL de la base la dio vps-new-db (cambia el inicio a postgresql+psycopg://). La clave: openssl rand -base64 48 (nueva, no la de desarrollo).
DAWERTECH_DATABASE_URL=postgresql+psycopg://dawertechbd:CAMBIAR@postgres:5432/dawertechbd
DAWERTECH_SECRET_KEY=
# https://localhost es el origen del APK (Capacitor).
DAWERTECH_CORS_ORIGINS=https://dawer.cfd,https://localhost
DAWERTECH_MEDIA_DIR=/app/media
DAWERTECH_MEDIA_QUOTA_MB=100
DAWERTECH_APK_REPOSITORY=gochoag/DawerTech
